# Copy to .env and fill in the key for whichever provider you use.
# LLM_PROVIDER selects the adapter; only that provider's key is required.

LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default model for the selected provider.
# LLM_MODEL=
